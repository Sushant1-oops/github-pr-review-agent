# ── Required ──────────────────────────────────────────────────────
# Get a free key at https://build.nvidia.com (NVIDIA NIM)
NVIDIA_API_KEY=nvapi_your_key_here
GITHUB_TOKEN=ghp_your_token_here
# Use a long, random value — this is required (no insecure default anymore).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_value

# ── Required to use POST /api/review (manual trigger) ─────────────
# If left blank, that endpoint is hard-disabled (fails closed) rather
# than silently open to anyone who can reach the server.
# Generate one the same way as above.
API_KEY=replace_with_a_long_random_value

# ── Optional ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Strong model for Security, Performance, and the Judge grounding pass.
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Lighter/faster model for Style and Test Coverage.
NVIDIA_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MAX_TOKENS=2048
TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
# Off by default: extended "thinking" costs output-token budget on the
# specialist agents, which only need to emit a findings list.
NVIDIA_ENABLE_THINKING=false
MAX_DIFF_CHARS=20000
MAX_CONCURRENT_LLM_CALLS=1
