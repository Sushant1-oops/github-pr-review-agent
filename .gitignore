# =====================================================================
# Environments & Secrets (CRITICAL)
# =====================================================================
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
*.key

# Keep the example templates tracked
!.env.example
!frontend/.env.example

# =====================================================================
# Python & Virtual Environments
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Linters & Type Checking
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Packaging & Distribution
build/
dist/
*.egg-info/
.eggs/

# =====================================================================
# Frontend (Node.js / React / Vite)
# =====================================================================
frontend/node_modules/
node_modules/

# Vite build artifacts
frontend/dist/
frontend/dist-ssr/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =====================================================================
# Evaluation Runs, Logs & Scratch Artifacts
# =====================================================================
*.log
evals/results/eval_*.json
evals/results/eval_*.md
evals/results/*.log

# =====================================================================
# Operating System & IDE Specific
# =====================================================================
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
